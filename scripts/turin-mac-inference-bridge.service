[Unit]
Description=Bridge Turin backend traffic to the private Mac Ollama SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:15435,bind=172.19.0.1,reuseaddr,fork TCP:127.0.0.1:15434
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target